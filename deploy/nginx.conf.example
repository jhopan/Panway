# Panway behind nginx with TLS.
# Copy deploy/certs/fullchain.pem and privkey.pem, then replace the host name.
# Start with: docker compose --profile tls up -d

server {
    listen 80;
    server_name panway.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name panway.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Request bodies: keep in sync with MAX_REQUEST_BODY_MB.
    client_max_body_size 32m;

    # Streaming completions must not be buffered by the proxy.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    set_real_ip_from 127.0.0.1;

    location / {
        proxy_pass http://panway:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
    }
}