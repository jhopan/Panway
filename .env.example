# Konfigurasi Panway — AI API gateway untuk menjual token AI.
# Salin jadi .env lalu isi.

# --- Server ---
PORT=3000
SESSION_SECRET=ubah-ke-string-acak-panjang
SQLITE_PATH=panway.db

# --- Branding ---
# Diatur lewat panel admin (设置 -> 运营设置 -> 系统设置), bukan di sini.

# --- PanRouter (upstream) ---
# Satu channel OpenAI-compatible. Isi lewat panel admin (渠道管理), bukan di sini.

# --- PanWallet (pembayaran) ---
# PANWALLET_ENABLED=true mengaktifkan integrasi saldo IDR.
PANWALLET_ENABLED=false
# URL API PanWallet (bukan URL portal).
PANWALLET_URL=https://panwallet.jhopan.my.id
# Product key PanWallet untuk produk "panway".
PANWALLET_KEY=
# Berapa unit kuota per 1 rupiah. Default 1 = 1 kuota = Rp1.
PANWALLET_QUOTA_PER_IDR=1
# URL portal PanWallet untuk customer's reference (opsional).
PANWALLET_PUBLIC_URL=https://panwallet.jhopan.my.id

# --- Unit harga ---
# QuotaPerUnit: berapa unit kuota = 1 "mata uang" yang ditampilkan.
# Dengan PanWallet, set 1 supaya 1 kuota = Rp1.
# Diatur lewat panel admin (设置 -> 运营设置 -> 额度设置).
QUOTA_PER_UNIT=1
# Tampilkan saldo dalam bentuk mata uang (bukan unit mentah).
DISPLAY_IN_CURRENCY_ENABLED=true

# --- Model pricing ---
# Disesuaikan lewat panel admin (设置 -> 模型倍率). Nilai default ada di
# relay/billing/ratio/panrouter.go.

# --- Logging ---
# LOG_SQL_DSN (opsional, pisahkan log ke DB lain)
# SQL_DSN (opsional, PostgreSQL). Kosongkan untuk SQLite.
# REDIS_CONN_STRING (opsional, untuk batch update cache)
# MEMORY_CACHE_ENABLED=true (opsional, quota update jadi delayed)
