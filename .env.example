# Konfigurasi Panway — AI API gateway untuk menjual token AI.
# Salin jadi .env lalu isi.

# --- Server ---
PORT=3000
# Wajib di produksi (GIN_MODE=release): string acak >= 32 karakter. Ganti
# nilai contoh ini. Tanpa nilai stabil, semua sesi hilang tiap restart.
SESSION_SECRET=ubah-ke-string-acak-panjang
SQLITE_PATH=panway.db

# --- Keamanan produksi ---
# Origin browser (dipisah koma) yang boleh memanggil /v1 dan /dashboard
# dengan cookie. Kosong = hanya same-origin, aman untuk console + landing
# yang disajikan Panway sendiri. Isi hanya bila SDK dipanggil dari browser.
# Contoh: https://console.contoh.com
CORS_ALLOWED_ORIGINS=
# Alamat reverse proxy yang header X-Forwarded-For-nya dipercaya, dipisah
# koma. Kosong = tidak ada proxy yang dipercaya, IP klien diambil dari
# koneksi TCP. Isi IP proxy (mis. 127.0.0.1 untuk nginx lokal) supaya rate
# limit memakai IP pelanggan, bukan IP proxy.
TRUSTED_PROXIES=
# Batas ukuran satu request body dalam MB, termasuk body gzip yang sudah
# didekompresi. 0 = tanpa batas.
MAX_REQUEST_BODY_MB=32
# Kirim cookie sesi hanya lewat HTTPS. Nyalakan setelah console di belakang TLS.
SESSION_COOKIE_SECURE=false
# Strict-Transport-Security (detik). 0 = mati. Nyalakan hanya di domain HTTPS final.
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false
# Cache in-process daftar harga publik /api/pricing (detik). Edit harga di
# panel langsung membatalkan cache; TTL hanya membatasi perubahan channel.
PRICING_CACHE_SECONDS=30
# Cara menagih usage yang ditandai "estimated" oleh upstream:
#   local    = hitung ulang dari tokenizer Panway + overhead prompt yang
#              dipelajari dari usage exact (default, pelanggan tidak ditagih
#              estimasi 5x lipat)
#   upstream = pakai angka estimasi upstream apa adanya (samakan dengan meter
#              upstream, tapi bisa menagih jauh di atas token asli)
ESTIMATED_USAGE_MODE=local

# --- SQLite & operasi ---
# Timeout menunggu lock SQLite (ms).
SQLITE_BUSY_TIMEOUT=5000
# SQLite satu writer; biarkan 1 kecuali sudah diukur.
SQL_MAX_OPEN_CONNS=1
# Backup otomatis VACUUM INTO. Simpan juga file TOKEN_KEY_FILE!
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_DIR=data/backups
SQLITE_BACKUP_INTERVAL_HOURS=24
SQLITE_BACKUP_KEEP=7
# Hapus log operasi lebih tua dari N hari. 0 = simpan selamanya.
LOG_RETENTION_DAYS=90
# Retry ke channel lain saat upstream gagal (butuh channel kedua).
RETRY_TIMES=0
# Timeout upstream dalam detik. 0 = tanpa batas (streaming bisa menggantung).
# Set mis. 600 setelah mengukur durasi stream terpanjang.
RELAY_TIMEOUT=0

# --- Keamanan tambahan ---
# Kunci enkripsi API key pelanggan. Kosong = dibuat otomatis di TOKEN_KEY_FILE.
# Jika diisi, jangan diubah setelah ada data; key lama tidak bisa dibuka.
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_FILE=data/token.key
# Notifikasi Telegram saat saldo pelanggan di bawah N kuota. 0 = mati.
LOW_BALANCE_THRESHOLD=0
LOW_BALANCE_NOTIFY_INTERVAL_HOURS=24
# Prometheus /metrics. Isi METRICS_TOKEN bila port bisa diakses publik.
ENABLE_METRICS=false
METRICS_TOKEN=

# --- Branding ---
# Diatur lewat panel admin (设置 -> 运营设置 -> 系统设置), bukan di sini.

# --- PanRouter (upstream) ---
# Satu channel OpenAI-compatible. Isi lewat panel admin (渠道管理), bukan di sini.

# --- PanWallet (pembayaran) ---
# PANWALLET_ENABLED=true mengaktifkan integrasi saldo IDR.
PANWALLET_ENABLED=false
# URL API PanWallet (bukan URL portal).
PANWALLET_URL=https://panwallet.jhopan.my.id
# Product key PanWallet untuk produk "panway".
PANWALLET_KEY=
# Berapa unit kuota per 1 rupiah. Default 1 = 1 kuota = Rp1.
PANWALLET_QUOTA_PER_IDR=1
# URL portal PanWallet untuk customer's reference (opsional).
PANWALLET_PUBLIC_URL=https://panwallet.jhopan.my.id

# --- Unit harga ---
# QuotaPerUnit: berapa unit kuota = 1 "mata uang" yang ditampilkan.
# Dengan PanWallet, set 1 supaya 1 kuota = Rp1.
# Diatur lewat panel admin (设置 -> 运营设置 -> 额度设置).
QUOTA_PER_UNIT=1
# Tampilkan saldo dalam bentuk mata uang (bukan unit mentah).
DISPLAY_IN_CURRENCY_ENABLED=true

# --- Model pricing ---
# Disesuaikan lewat panel admin (设置 -> 模型倍率). Nilai default ada di
# relay/billing/ratio/panrouter.go.

# --- Logging ---
# LOG_SQL_DSN (opsional, pisahkan log ke DB lain)
# SQL_DSN (opsional, PostgreSQL). Kosongkan untuk SQLite.
# REDIS_CONN_STRING (opsional, untuk batch update cache)
# MEMORY_CACHE_ENABLED=true (opsional, quota update jadi delayed)

# --- Login & verifikasi Telegram ---
# Telegram dipakai sebagai VERIFIKASI (bukan login): pelanggan daftar
# pakai email atau Google, lalu konfirmasi kode yang dikirim ke chat-nya.
# TelegramVerificationEnabled=false -> tombol verifikasi disembunyikan.
TELEGRAM_VERIFICATION_ENABLED=false
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# Username bot tanpa "@" (untuk petunjuk ke pelanggan)
TELEGRAM_BOT_USERNAME=
# Biarkan kosong untuk api.telegram.org resmi
TELEGRAM_API_BASE_URL=
